# ── Model identity ─────────────────────────────────────────────────────────────
# Type: public | gated | custom
MODEL_TYPE=public

# [REQUIRED] HuggingFace repo-id (public/gated) or absolute local path (custom)
# Set this in RunPod Template > Environment Variables
MODEL_NAME=

# ── HuggingFace authentication ─────────────────────────────────────────────────
# Required only when MODEL_TYPE=gated
HF_TOKEN=

# ── vLLM engine settings ───────────────────────────────────────────────────────
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=4096

# Data type: auto | float16 | bfloat16 | float32
DTYPE=auto

# Quantization method (optional): awq | gptq | squeezellm | ""
QUANTIZATION=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── HuggingFace cache location (inside the pod) ────────────────────────────────
HF_HOME=/runpod-volume/hub
