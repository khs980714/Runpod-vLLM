{
  "tests": [
    {
      "name": "chat_completions",
      "gpuTypeId": "NVIDIA GeForce RTX 4090",
      "gpuCount": 1,
      "allowedCudaVersions": ["12.1"],
      "env": [
        { "key": "MODEL_TYPE", "value": "public" },
        { "key": "MODEL_NAME", "value": "facebook/opt-125m" },
        { "key": "MAX_MODEL_LEN", "value": "512" },
        { "key": "TENSOR_PARALLEL_SIZE", "value": "1" }
      ],
      "input": {
        "endpoint": "chat/completions",
        "messages": [
          { "role": "system", "content": "You are a helpful assistant." },
          { "role": "user", "content": "What is the capital of France?" }
        ],
        "temperature": 0.7,
        "max_tokens": 64,
        "top_p": 0.95
      },
      "timeout": 120000
    },
    {
      "name": "text_completions",
      "gpuTypeId": "NVIDIA GeForce RTX 4090",
      "gpuCount": 1,
      "allowedCudaVersions": ["12.1"],
      "env": [
        { "key": "MODEL_TYPE", "value": "public" },
        { "key": "MODEL_NAME", "value": "facebook/opt-125m" },
        { "key": "MAX_MODEL_LEN", "value": "512" },
        { "key": "TENSOR_PARALLEL_SIZE", "value": "1" }
      ],
      "input": {
        "endpoint": "completions",
        "prompt": "The quick brown fox",
        "temperature": 0.8,
        "max_tokens": 64,
        "top_p": 1.0,
        "stop": ["\n"]
      },
      "timeout": 120000
    },
    {
      "name": "models_list",
      "gpuTypeId": "NVIDIA GeForce RTX 4090",
      "gpuCount": 1,
      "allowedCudaVersions": ["12.1"],
      "env": [
        { "key": "MODEL_TYPE", "value": "public" },
        { "key": "MODEL_NAME", "value": "facebook/opt-125m" },
        { "key": "MAX_MODEL_LEN", "value": "512" },
        { "key": "TENSOR_PARALLEL_SIZE", "value": "1" }
      ],
      "input": {
        "endpoint": "models"
      },
      "timeout": 120000
    }
  ]
}
